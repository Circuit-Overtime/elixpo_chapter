# elixpoo secrets — copy to .env.local (gitignored) and fill in.
# Clean-slate naming: these are the ONLY recognized variables.

# --- Pollinations (model inference) ---
POLLINATIONS_API_KEY=sk_xxx
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1

# --- GitHub App (acts as elixpoo[bot]) ---
ELIXPO_GH_APP_ID=123456
# PEM contents inline (preferred for CI). Keep the real newlines.
ELIXPO_GH_PRIVATE_KEY=
# OR, for local dev only, a path to the .pem file:
ELIXPO_GH_PRIVATE_KEY_PATH=
ELIXPO_GH_WEBHOOK_SECRET=
ELIXPO_GH_BOT_USERNAME=elixpoo
# Control repo that stores state/, candidate issues, and the Project board.
ELIXPO_GH_CONTROL_REPO=owner/repo
# Provided automatically inside GitHub Actions; set locally only for testing.
GITHUB_TOKEN=

# --- optional cache (Upstash Redis, HTTP/REST) ---
# Leave blank to use the in-memory cache. Caches embeddings/summaries only —
# never durable state. Reachable from both Actions and Cloudflare.
ELIXPO_UPSTASH_URL=
ELIXPO_UPSTASH_TOKEN=

# --- misc ---
ELIXPO_DEBUG=false

# elixpoo secrets — copy to .env.local (gitignored) and fill in.

# --- Pollinations (ONE key: text + image + embeddings) ---
ELIXPO_POLLINATIONS_API_KEY=sk_xxx
# ELIXPO_POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1   # optional override

# --- GitHub App (acts as elixpoo[bot]) ---
ELIXPO_GITHUB_APP_ID=123456
# Path to the App private key .pem (gitignored). For CI, paste the PEM into
# ELIXPO_GITHUB_PRIVATE_KEY instead.
ELIXPO_GITHUB_PRIVATE_KEY_PATH=elixpo_github_bot.pem
ELIXPO_GITHUB_PRIVATE_KEY=
ELIXPO_GITHUB_WEBHOOK_SECRET=
ELIXPO_GITHUB_BOT_USERNAME=elixpoo
# Control repo that stores state/, candidate issues, and the Project board.
ELIXPO_GITHUB_CONTROL_REPO=owner/repo
# Plain token for GitHub REST/search. In Actions this is the auto GITHUB_TOKEN;
# for local testing use a fine-grained PAT (public repo, read-only is enough for Scout).
GITHUB_TOKEN=

# OAuth App (login / BYOP flows; not needed by the squads)
ELIXPO_GITHUB_CLIENT_ID=
ELIXPO_GITHUB_CLIENT_SECRET=

# --- optional cache (Upstash Redis, HTTP/REST) — caches embeddings/summaries, never state ---
ELIXPO_UPSTASH_URL=
ELIXPO_UPSTASH_TOKEN=

# --- misc ---
ELIXPO_DEBUG=false

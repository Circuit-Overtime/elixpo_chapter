{
    "name": "elixpo-pay",
    "version": "0.1.0",
    "private": true,
    "description": "Elixpo Pay — centralized payments + payouts SaaS for the Elixpo ecosystem. Hosted checkout, unified ledger, entitlements, and creator payouts on Cloudflare's edge.",
    "homepage": "https://payouts.elixpo.com",
    "author": {
        "name": "Elixpo",
        "url": "https://elixpo.com"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "pages:build": "npx @cloudflare/next-on-pages",
        "start": "next start",
        "lint": "biome check .",
        "format": "biome check --write .",
        "db:create": "wrangler d1 create elixpo_pay",
        "db:migrate": "wrangler d1 migrations apply elixpo_pay --remote",
        "db:migrate:local": "wrangler d1 migrations apply elixpo_pay --local",
        "db:query:remote": "wrangler d1 execute elixpo_pay --remote",
        "db:tables": "wrangler d1 execute elixpo_pay --remote --command \"SELECT name FROM sqlite_master WHERE type='table';\""
    },
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "7.0.2",
        "@mui/material": "7.0.2",
        "@mui/system": "7.0.2",
        "biome": "^0.3.3",
        "jose": "^5.9.6",
        "next": "15.2.4",
        "react": "19.2.3",
        "react-dom": "19.2.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@cloudflare/next-on-pages": "^1.13.16",
        "@cloudflare/workers-types": "^4.20240905.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "^4",
        "typescript": "^5",
        "wrangler": "^4.67.0"
    }
}

{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteProperties": "preserve",
            "quoteStyle": "double"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "complexity": {
                "useLiteralKeys": "off",
                "noBannedTypes": "off"
            },
            "suspicious": {
                "noExplicitAny": "info",
                "noArrayIndexKey": "info"
            },
            "performance": {
                "noImgElement": "info",
                "noAccumulatingSpread": "info"
            },
            "a11y": {
                "useButtonType": "info",
                "noSvgWithoutTitle": "info"
            }
        }
    },
    "files": {
        "includes": [
            "**",
            "!**/node_modules/**",
            "!**/.next/**",
            "!**/.vercel/**",
            "!**/.wrangler/**",
            "!**/*.css"
        ]
    },
    "css": {
        "formatter": { "enabled": false },
        "linter": { "enabled": false }
    }
}

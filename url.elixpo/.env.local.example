# ──────────────────────────────────────────────────────────────────────
# ElixpoURL — local env template.  Copy to .env.local and fill in.
# Production values live in Cloudflare Pages → Settings → Environment vars
# (and the encrypted .env via sops).  NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────────────

# ── Existing (already used by the app) ────────────────────────────────
NEXT_PUBLIC_ELIXPO_CLIENT_ID=          # Elixpo Accounts SSO client id
ELIXPO_CLIENT_SECRET=                  # Elixpo Accounts SSO secret
BASE_URL=http://localhost:3000         # this app's public origin
SAFE_BROWSING_API_KEY=                 # Google Safe Browsing (URL denylist)
ELIXPO_WEBHOOK_SECRET=                 # verifies accounts.elixpo webhooks (sha256=)

# ── Elixpo Pay — subscriptions / autopay (payouts.elixpo.com) ─────────
# Buyer never touches card data: we create a checkout session server-side
# with the secret key, redirect to hosted checkout, then receive
# entitlement.updated.  All paid prices are type=recurring (autopay).
ELIXPO_PAY_BASE_URL=https://payouts.elixpo.com
ELIXPO_PAY_APP_ID=                     # App under your merchant (e.g. lixurl)
ELIXPO_PAY_SECRET_KEY=                 # sk_live_… — signs checkout-session creation
ELIXPO_PAY_WEBHOOK_SECRET=             # whsec_… — verifies entitlement.updated (t=,v1=)

# Price ids from your Catalog sync (one per tier × currency × interval).
ELIXPO_PAY_PRICE_PRO_INR_MONTHLY=
ELIXPO_PAY_PRICE_PRO_INR_ANNUAL=
ELIXPO_PAY_PRICE_PRO_USD_MONTHLY=
ELIXPO_PAY_PRICE_PRO_USD_ANNUAL=
ELIXPO_PAY_PRICE_BUSINESS_INR_MONTHLY=
ELIXPO_PAY_PRICE_BUSINESS_INR_ANNUAL=
ELIXPO_PAY_PRICE_BUSINESS_USD_MONTHLY=
ELIXPO_PAY_PRICE_BUSINESS_USD_ANNUAL=

# ── Elixpo Mails — transactional email (mails.elixpo.com) ─────────────
# We are the SENDER: sign each trigger with the product secret (t.rawBody)
# and POST to /v1/hooks/<endpoint_key>.  One endpoint_key per template.
ELIXPO_MAILS_BASE_URL=https://mails.elixpo.com
ELIXPO_MAILS_CLIENT_ID=                # product client_id
ELIXPO_MAILS_SECRET=                   # product shared secret (HMAC, shown once)
ELIXPO_MAILS_HOOK_RECEIPT=             # whe_… upgrade / renewal receipt (transactional)
ELIXPO_MAILS_HOOK_PAYMENT_FAILED=      # whe_… dunning / charge failed
ELIXPO_MAILS_HOOK_CANCELED=            # whe_… cancellation + downgrade-to-free
ELIXPO_MAILS_HOOK_WELCOME=             # whe_… optional: first sign-in welcome
